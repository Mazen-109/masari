          "name": "tenants_slug_unique",
          "nullsNotDistinct": false,
          "columns": [
            "slug"
          ]
        }
      },
      "policies": {},
      "checkConstraints": {
        "tenants_slug_check": {
          "name": "tenants_slug_check",
          "value": "slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND char_length(slug) BETWEEN 3 AND 40"
        },
        "tenants_name_ar_check": {
          "name": "tenants_name_ar_check",
          "value": "char_length(name_ar) BETWEEN 1 AND 120"
        },
        "tenants_name_en_check": {
          "name": "tenants_name_en_check",
          "value": "char_length(name_en) BETWEEN 1 AND 120"
        },
        "tenants_status_check": {
          "name": "tenants_status_check",
          "value": "status IN ('active','suspended')"
        },
        "tenants_allowed_email_domains_check": {
          "name": "tenants_allowed_email_domains_check",
          "value": "cardinality(allowed_email_domains) <= 20"
        },
        "tenants_levels_count_check": {
          "name": "tenants_levels_count_check",
          "value": "levels_count BETWEEN 1 AND 7"
        },
        "tenants_enabled_modules_check": {
          "name": "tenants_enabled_modules_check",
          "value": "enabled_modules <@ ARRAY['mueed','codejudge','mizan','kitabi','careermap','tadreeb']::text[]"
        }
      },
      "isRLSEnabled": false
    }
