# Masari — environment variables (contracts/http-and-env.md §3).
# Copy to `.env` at the repository root. These are local-only development values for the PostgreSQL
# container of `pnpm db:up`; they are not secrets. Never put real credentials in this file.

# development | test | production
APP_ENV=development
# Absolute origin without a trailing slash (https:// required in production)
# Also read by `next build`: HSTS is sent only when APP_URL is https:// at build time (docs/deployment.md)
APP_URL=http://localhost:3000

# Runtime login role used by the web app (created/updated by `pnpm db:migrate`; never superuser)
DATABASE_URL=postgres://masari_web:masari_dev_web@localhost:5432/masari
# Owner role: migrations, operator scripts, and tests only — never read by apps/web/src
DATABASE_MIGRATION_URL=postgres://masari_owner:masari_dev_owner@localhost:5432/masari

# At least 32 characters
BETTER_AUTH_SECRET=local-development-only-secret-change-me-please

# Reverse proxies in front of the app that append the client address to X-Forwarded-For (0–5)
TRUSTED_PROXY_HOPS=0

# capture (writes emails to files; refused in production) | smtp
EMAIL_TRANSPORT=capture
EMAIL_FROM="Masari <no-reply@localhost>"
# Optional; default .tmp/emails, resolved against apps/web
# EMAIL_CAPTURE_DIR=.tmp/emails

# Required only when EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=no-reply@example.edu
# SMTP_PASSWORD=<set in the deployment environment, never here>
# SMTP_SECURE=false
