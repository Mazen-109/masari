{
  "name": "masari",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @masari/web dev",
    "build": "pnpm --filter @masari/web build",
    "start": "pnpm --filter @masari/web start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @masari/db generate",
    "db:migrate": "pnpm --filter @masari/db migrate",
    "db:seed": "pnpm --filter @masari/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
